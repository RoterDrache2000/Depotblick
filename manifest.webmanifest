{
  "name": "Depotblick",
  "short_name": "Depotblick",
  "description": "Dein Depot, deine Statistiken, deine Sparpläne. Läuft lokal, ohne Konto.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "background_color": "#F4F6F7",
  "theme_color": "#2B4ACB",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/json": [".depotblick"] } }
  ],
  "shortcuts": [
    { "name": "Sparpläne", "url": "./#sparplaene" },
    { "name": "Statistiken", "url": "./#statistiken" }
  ]
}
